# Copia este archivo como .env.local para desarrollo local.
# Solo valores públicos: la clave publicable de Supabase está protegida por RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Ruta base del sitio. En GitHub Pages: /lam-virtual-acars/
VITE_BASE_PATH=/

# Mapa del PIREP (opcional). Por omisión: teselas de OpenStreetMap con su atribución.
# Si el tráfico crece, usa un proveedor propio o comercial; con datos de OSM la
# atribución a OpenStreetMap sigue siendo obligatoria.
# VITE_MAP_TILE_URL=https://tiles.ejemplo.com/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
