<Window x:Class="LamAcars.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LamAcars.App"
        Title="LAM ACARS" Width="560" Height="720" MinWidth="480" MinHeight="560"
        Background="{StaticResource Bg}" Icon="Assets/lam.ico" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:BoolToVisibility x:Key="Show" />
    <local:BoolToVisibility x:Key="Hide" Invert="True" />
    <local:StatusBrush x:Key="StatusBrush" />
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Border Width="44" Height="44" CornerRadius="8" Background="White" Margin="0,0,12,0">
        <Image Source="Assets/lam-128.png" Margin="4" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="LAM ACARS" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Foreground="{StaticResource Muted}">
          <Run Text="Líneas Aéreas Mexicanas · conector para MSFS 2024 · v" /><Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- Versión nueva -->
    <Border Grid.Row="1" Background="#1A2A3D" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
            VerticalAlignment="Top" Visibility="{Binding UpdateAvailable, Converter={StaticResource Show}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Descargar" Padding="10,4" Margin="8,0,0,0"
                VerticalAlignment="Center" Click="Update_Click" />
        <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Foreground="{StaticResource Gold}" FontSize="12" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Estado -->
    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,16">
      <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding SimConnected, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding SimStatusText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding NetOnline, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding NetStatusText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Piloto -->
    <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Olvidar equipo" Padding="8,4"
                  Visibility="{Binding IsLinked, Converter={StaticResource Show}}" Click="Unlink_Click" />
          <TextBlock Text="{Binding PilotText}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding AircraftText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />

        <!-- SDK de PMDG sin activar -->
        <DockPanel Margin="0,10,0,0" Visibility="{Binding PmdgSetupNeeded, Converter={StaticResource Show}}">
          <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Activar" Padding="10,4" Margin="8,0,0,0"
                  VerticalAlignment="Center" Click="EnablePmdg_Click" />
          <TextBlock Text="{Binding PmdgSetupText}" TextWrapping="Wrap" Foreground="{StaticResource Gold}" FontSize="12" />
        </DockPanel>

        <!-- Vincular -->
        <StackPanel Visibility="{Binding IsLinked, Converter={StaticResource Hide}}" Margin="0,12,0,0">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                     Text="Vincula este equipo con tu cuenta de LAM para que ACARS envíe tus vuelos." />
          <Button Style="{StaticResource Primary}" Content="Vincular este equipo" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Link_Click" />
          <TextBlock Text="{Binding LinkCode}" FontFamily="Consolas" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding LinkHint}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Reservas -->
      <StackPanel Grid.Row="0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsLinked}" Value="True" />
                  <Condition Binding="{Binding InFlight}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Actualizar" Padding="10,4" Click="Refresh_Click" />
          <TextBlock Text="Tus vuelos reservados" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="FlightList" ItemsSource="{Binding Flights}" Height="150" Background="{StaticResource Surface}"
                 BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                  <Run Text="{Binding Airline.Name, Mode=OneWay}" /><Run Text=" · plan SimBrief: " /><Run Text="{Binding HasOfp, Mode=OneWay, Converter={x:Static local:YesNo.Instance}}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Carga la aeronave en MSFS, elige el vuelo y pulsa Iniciar ACARS. Las fases se detectan solas." />
        <Button Style="{StaticResource Primary}" Content="Iniciar ACARS" HorizontalAlignment="Left" Margin="0,10,0,0"
                IsEnabled="{Binding CanStartFlight}" Click="Start_Click" />
      </StackPanel>

      <!-- Vuelo en curso -->
      <Border Grid.Row="0" Background="{StaticResource Surface}" CornerRadius="8" Padding="16"
              Visibility="{Binding InFlight, Converter={StaticResource Show}}">
        <StackPanel>
          <TextBlock Text="{Binding ActiveFlight.Display}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="FASE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" />
          <TextBlock Text="{Binding PhaseText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
          <TextBlock Text="{Binding TelemetryText}" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource Primary}" Content="Terminar vuelo" Click="Finish_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource DangerButton}" Content="Abandonar vuelo" Click="Abort_Click" />
          </StackPanel>
          <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                     Text="El vuelo se cierra solo al apagar motores y APU (si el avión la tiene) y poner el freno de estacionamiento." />
        </StackPanel>
      </Border>

      <!-- Bitácora -->
      <ListBox x:Name="LogList" Grid.Row="1" Margin="0,16,0,8" Background="#08111B" BorderBrush="{StaticResource Line}"
               Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" />

      <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}">
        <Run Text="Pendientes de enviar: " /><Run Text="{Binding Pending, Mode=OneWay}" />
      </TextBlock>
    </Grid>
  </Grid>
</Window>
