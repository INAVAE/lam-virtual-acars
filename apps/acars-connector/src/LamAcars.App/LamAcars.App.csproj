<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LamAcars.App</RootNamespace>
    <AssemblyName>LamAcars</AssemblyName>
    <ApplicationIcon>Assets\lam.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Necesario para compilar WPF en los ejecutores de Linux de CI (solo compilación). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF y Windows Forms (solo para el ícono de la bandeja) comparten nombres: no importar Forms globalmente. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LamAcars.Core\LamAcars.Core.csproj" />
    <ProjectReference Include="..\LamAcars.Sim\LamAcars.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\lam.ico" />
    <Resource Include="Assets\lam-128.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\lib\SimConnect.dll')">
    <!-- DLL nativa del SDK de MSFS 2024. No está en el repositorio: CI la agrega al paquete. -->
    <None Include="..\..\lib\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
